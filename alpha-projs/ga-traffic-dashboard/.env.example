# Copy to .env.local and fill in. .env.local is gitignored - never commit it.

# Numeric GA4 property ID (GA Admin > Property Settings)
GA_PROPERTY_ID=

# Path to a service account key JSON with Viewer access on the property
GOOGLE_APPLICATION_CREDENTIALS=

# Optional: deep link shown as "Open in Google Analytics"
# e.g. https://analytics.google.com/analytics/web/#/a<ACCOUNT>p<PROPERTY>/reports/explorer?r=all-pages-and-screens
VITE_GA_REPORT_URL=
