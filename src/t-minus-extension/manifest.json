{
  "manifest_version": 3,
  "name": "T-minus",
  "description": "Desktop notifications before your Google Calendar meetings, with one-click join.",
  "version": "0.0.1",
  "minimum_chrome_version": "116",
  "key": "",
  "permissions": [
    "alarms",
    "identity",
    "notifications",
    "storage"
  ],
  "host_permissions": [
    "https://www.googleapis.com/*",
    "https://oauth2.googleapis.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "T-minus",
    "default_icon": {
      "16": "icon-16.png",
      "32": "icon-32.png",
      "48": "icon-48.png",
      "128": "icon-128.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "icons": {
    "16": "icon-16.png",
    "32": "icon-32.png",
    "48": "icon-48.png",
    "128": "icon-128.png"
  }
}
